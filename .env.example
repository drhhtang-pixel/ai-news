# Required: Anthropic API key for Claude
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required: Tavily API key for web search
# Get one at https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Topic to search for (default: "AI news today")
SEARCH_TOPIC=AI news today

# Optional: Output file path for summaries (default: summaries.md)
# WARNING: Do NOT commit .env to git — it contains secret keys
OUTPUT_FILE=summaries.md
